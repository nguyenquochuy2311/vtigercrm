# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored (contains secrets) — never commit it.

# MySQL credentials (used by docker-compose for the mysql service)
DB_ROOT_PASSWORD=change_me_root_password
DB_PASSWORD=change_me_vtiger_password

# UID/GID that Apache (www-data) runs as inside the container.
# 33 = the image's default www-data. Set to your host user's id (run `id -u`/`id -g`)
# if you want bind-mounted files owned by your host account.
PUID=33
PGID=33
